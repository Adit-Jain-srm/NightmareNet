# NightmareNet Backend & Infrastructure Environment Variables
# Copy this file to .env before running the project.
# Update the values as needed for your local environment.

# API Configuration
# Leave unset to block cross-origin requests. Set explicitly for production.
# Examples:
#   - Single origin: NIGHTMARENET_CORS_ORIGINS=http://localhost:3000
#   - Multiple origins: NIGHTMARENET_CORS_ORIGINS=http://localhost:3000,https://example.com
#   - Allow all: NIGHTMARENET_CORS_ORIGINS=*
NIGHTMARENET_CORS_ORIGINS=http://localhost:3000

# Logging level for the API (debug, info, warning, error)
NIGHTMARENET_LOG_LEVEL=info

# API authentication key (leave empty for local dev if auth is disabled)
NIGHTMARENET_API_KEY=

# PostgreSQL
POSTGRES_DB=nightmarenet
POSTGRES_USER=nightmare
POSTGRES_PASSWORD=nightmare
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Connection URLs
# Local development (make dev)
NIGHTMARENET_DATABASE_URL=postgresql+psycopg://nightmare:nightmare@localhost:5432/nightmarenet
NIGHTMARENET_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Docker Compose
# Uncomment when using Docker Compose networking
# NIGHTMARENET_DATABASE_URL=postgresql+psycopg://nightmare:nightmare@db:5432/nightmarenet
# NIGHTMARENET_REDIS_URL=redis://redis:6379/0

# SQLAlchemy connection pool
NIGHTMARENET_DB_POOL_SIZE=10
NIGHTMARENET_DB_MAX_OVERFLOW=20
NIGHTMARENET_DB_POOL_TIMEOUT=30
NIGHTMARENET_DB_POOL_RECYCLE=3600


# Server ports
API_PORT=8000
FRONTEND_PORT=3000

# Celery worker settings
CELERY_CONCURRENCY=2
CELERY_LOGLEVEL=info
NIGHTMARENET_CELERY_QUEUE=nightmarenet
NIGHTMARENET_CELERY_INCLUDE=nightmarenet.tasks

# Device selection (auto, cpu, cuda)
NIGHTMARENET_DEVICE=auto

# Compliance Export Signing Key (RS256 private key for signing; use public key for verification)
NIGHTMARENET_SIGNING_KEY=

# Hosted auth (JWT + social OAuth + enterprise SSO)
NIGHTMARENET_JWT_SECRET=
NIGHTMARENET_SESSION_SECRET=
NIGHTMARENET_GITHUB_CLIENT_ID=
NIGHTMARENET_GITHUB_CLIENT_SECRET=
NIGHTMARENET_GOOGLE_CLIENT_ID=
NIGHTMARENET_GOOGLE_CLIENT_SECRET=

# Enterprise OIDC SSO (Azure AD / Okta / Auth0) — optional single-tenant default
NIGHTMARENET_OIDC_DEFAULT_METADATA_URL=
NIGHTMARENET_OIDC_CLIENT_ID=
NIGHTMARENET_OIDC_CLIENT_SECRET=
NIGHTMARENET_OIDC_ROLE_CLAIM=groups
NIGHTMARENET_SSO_SESSION_SECONDS=28800

# Audit log retention (days). Default 365 (1 year) for SOC 2 CC7.2.
AUDIT_RETENTION_DAYS=365
